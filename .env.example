# DeepSeek 对话记录导出工具 - 环境变量配置
# 复制此文件为 .env 或 .env.local，然后填入你的值

# DeepSeek 登录 Cookie（必需）
# 获取方法：F12 → Network → 找到请求 → 复制 Cookie 头的值
DEEPSEEK_COOKIE="your_cookie_here"

# DeepSeek Bearer Token（必需）
# 获取方法：F12 → Network → 找到请求 → 复制 authorization 头中 "Bearer " 后面的值
DEEPSEEK_BEARER_TOKEN="your_bearer_token_here"

# 可选：默认输出目录
# OUTPUT_DIR="./deepseek_chats"

# 可选：默认导出日期（YYYY-MM-DD，留空为今天）
# EXPORT_DATE="2026-05-30"
